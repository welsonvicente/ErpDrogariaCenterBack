# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
DB_DATABASE=pharmamind

# Autenticação
JWT_SECRET=troque-este-segredo-por-uma-string-aleatoria-longa
JWT_EXPIRES_IN=8h

# Logs
LOG_LEVEL=info

# CORS — origens do front autorizadas a chamar esta API, separadas por vírgula.
# Em produção, use o domínio real do front (sem barra no final).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://erp.drogariacenter.com.br
