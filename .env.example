# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
DB_DATABASE=pharmamind

# Autenticação
JWT_SECRET=troque-este-segredo-por-uma-string-aleatoria-longa
JWT_EXPIRES_IN=8h

# Logs
LOG_LEVEL=info

# CORS — origens do front autorizadas a chamar esta API, separadas por vírgula.
# Em produção, use o domínio real do front (sem barra no final).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://erp.drogariacenter.com.br

# Opcional — só necessária pra "buscar imagem automaticamente" na ferramenta
# de Cartazes (busca web + IA). Sem isso, a busca automática fica indisponível
# e o resto do sistema (incluindo o resto da ferramenta de Cartazes) funciona normal.
# ANTHROPIC_API_KEY=

# Cloudflare R2 — storage das imagens dos projetos de Cartazes (Story/Panfleto/
# Importar planilha). Sem essas variáveis, os endpoints de upload/presign
# respondem com erro claro (409) em vez de deixar o resto do sistema quebrar.
# Crie um bucket privado no painel Cloudflare (R2 > Create bucket) e um par de
# chaves de API com permissão de leitura/escrita nesse bucket (R2 > Manage API
# tokens). Configure também o CORS do bucket liberando o domínio do front para
# os métodos PUT/GET usados no upload direto.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
