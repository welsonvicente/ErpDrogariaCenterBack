# Copie este arquivo para ".env.test" e ajuste os valores para o seu ambiente.
#
# Usado só ao rodar "npm test" (Jest define NODE_ENV=test sozinho, que faz
# env.ts carregar este arquivo em vez do ".env" normal). O banco aqui é
# TRUNCADO inteiro a cada suíte de teste (ver src/tests/helpers/db.ts) —
# nunca aponte isso para o banco de desenvolvimento ou produção.

PORT=3334
NODE_ENV=test

# Banco de dados de TESTE — crie um banco separado do de desenvolvimento
# (ex.: "createdb nome_do_banco_test") antes de rodar os testes pela
# primeira vez, e aplique as migrations nele (NODE_ENV=test npm run migration:run).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
DB_DATABASE=pharmamind_test

JWT_SECRET=segredo-de-teste-qualquer-string-serve
JWT_EXPIRES_IN=8h

LOG_LEVEL=error

CORS_ORIGINS=http://localhost:5173
